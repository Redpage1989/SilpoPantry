# ─────────────────────────────────────────────────────────────
# «Сільпо: Сімейна комора» — приклад конфігурації
# Скопіюйте у .env.  .env у git НЕ потрапляє (див. .gitignore).
# Жодних реальних токенів, паролів чи персональних даних тут бути не може.
# ─────────────────────────────────────────────────────────────

# ── База даних ──────────────────────────────────────────────
# Локально (за замовчуванням, нічого встановлювати не треба):
DATABASE_PROVIDER="sqlite"
DATABASE_URL="file:./dev.db"
# Production:
# DATABASE_PROVIDER="postgresql"
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/silpo_pantry?schema=public"

# ── Базова адреса застосунку (потрібна для OAuth redirect_uri) ──
APP_BASE_URL="http://localhost:3210"

# ── Секрет для підпису сесійних cookie (згенеруйте свій) ──────
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# ── Офіційний MCP «Сільпо» ──────────────────────────────────
# Порожній SILPO_CLIENT_ID = застосунок зареєструє себе сам
# через Dynamic Client Registration (POST https://mcp.silpo.ua/register).
SILPO_MCP_URL="https://mcp.silpo.ua/mcp"
SILPO_CLIENT_ID=""
SILPO_CLIENT_SECRET=""

# "auto"  — live, якщо є валідний токен, інакше demo (рекомендовано)
# "live"  — тільки live, помилка якщо токена немає
# "mock"  — завжди seed-дані
SILPO_MCP_MODE="auto"

# ── Claude API для розпізнавання фото ───────────────────────
# Без ключа сканування працює в детермінованому DEMO-режимі
# і чесно позначається бейджем DEMO у інтерфейсі.
ANTHROPIC_API_KEY=""
ANTHROPIC_VISION_MODEL="claude-opus-5"

# ── Ліміти ──────────────────────────────────────────────────
MAX_UPLOAD_MB="8"
RATE_LIMIT_PER_MINUTE="30"
PHOTO_TTL_MINUTES="30"
